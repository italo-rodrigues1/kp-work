{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "frontend#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL", "VITE_WS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "backend#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "backend#test:cov": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "cache": false
    }
  }
}
