# Banco catálogo: guarda apenas o registro e a infraestrutura das workspaces.
# A workspace padrão continua neste banco para preservar dados existentes.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/chat_ai?schema=public"
# Conexão administrativa no mesmo cluster; o usuário precisa de CREATEDB.
WORKSPACE_DATABASE_ADMIN_URL="postgresql://postgres:postgrespassword@localhost:5433/postgres"
# Cada entrada ativa mantém seu próprio pool. Ajuste ambos conforme o limite de
# conexões do PostgreSQL (máximo aproximado = POOL_MAX * CACHE_MAX).
WORKSPACE_DATABASE_POOL_MAX="5"
WORKSPACE_DATABASE_CACHE_MAX="20"
# Entradas acima do limite só são encerradas depois deste tempo ocioso.
# O mínimo aceito pela aplicação é 60000 ms.
WORKSPACE_DATABASE_CACHE_IDLE_MS="60000"
WORKSPACE_DATABASE_LIST_CONCURRENCY="5"
AGENT_CALLBACK_TOKEN="chat-ai-agent-callback-local"

MINIO_ENDPOINT="http://localhost:9002"
MINIO_PUBLIC_ENDPOINT="http://localhost:9002"
MINIO_ACCESS_KEY="chataiapp"
MINIO_SECRET_KEY="chat-ai-app-secret-local"
MINIO_AGENT_CONTEXT_BUCKET="agent-contexts"
MINIO_CHAT_UPLOAD_BUCKET="chat-uploads"
# Allowlist global da API MinIO Community, aplicada pelo serviço no compose.
MINIO_CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
UPLOAD_DOCUMENT_MAX_FILE_SIZE_BYTES="104857600"
UPLOAD_MEDIA_MAX_FILE_SIZE_BYTES="10737418240"
UPLOAD_MULTIPART_THRESHOLD_BYTES="104857600"
UPLOAD_MULTIPART_PART_SIZE_BYTES="67108864"
UPLOAD_MAX_ATTACHMENTS="10"
UPLOAD_SESSION_TTL_SECONDS="86400"
UPLOAD_URL_TTL_SECONDS="900"
UPLOAD_CLEANUP_INTERVAL_MS="900000"
UPLOAD_CLEANUP_BATCH_SIZE="100"
