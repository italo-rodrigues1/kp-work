PORT="8000"
BACKEND_CALLBACK_URL="http://localhost:3001/api/chat/stream-chunk"
AGENT_CALLBACK_TOKEN="chat-ai-agent-callback-local"

MINIO_ENDPOINT="localhost:9002"
MINIO_ACCESS_KEY="chataiapp"
MINIO_SECRET_KEY="chat-ai-app-secret-local"
MINIO_SECURE="false"
# Somente a workspace padrão usa este bucket. As demais usam buckets
# determinísticos chat-ai-ws-<uuid-sem-hifens>-contexts validados pelo worker.
MINIO_AGENT_CONTEXT_BUCKET="agent-contexts"

RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5672"
RABBITMQ_USER="rabbitmq"
RABBITMQ_PASS="rabbitmqpassword"
RABBITMQ_QUEUE="agent_tasks"

QDRANT_HOST="localhost"
QDRANT_PORT="6333"

# Conteúdo de prompts/respostas não é enviado ao projeto Langfuse compartilhado
# por padrão. Ative conscientemente apenas se essa política for aceitável.
LANGFUSE_CAPTURE_CONTENT="false"
